    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/rss": "0.0.32",
    "@vercel/og": "1.0.2",
    "@vercel/routing-utils": "^6.5.0",
    "clsx": "2.1.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "geist": "^1.5.1",
    "gray-matter": "4.0.3",
    "lightningcss": "^1.33.0",
    "marked": "16.4.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "parse5": "^8.0.1",
    "preact": "^10.29.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-tweet": "3.3.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-toc": "9.0.0",
    "rss": "1.2.2",
    "shiki": "^4.4.3",
    "subset-font": "^2.7.0",
    "tailwindcss": "^4.1.17",
    "typescript": "7.0.2"
