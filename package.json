{
  "name": "blog",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run framework/dev.ts",
    "build": "node scripts/build.mjs",
    "build:bun": "bun run build.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --write '**/*.{js,ts,tsx}'",
    "snapshot": "bun run tools/snapshot.ts",
    "verify": "bun run tools/diff-html.ts",
    "gate": "bun run build.ts && bun run tools/snapshot.ts --dir .vercel/output/static --out .cache/snapshot-current --raw .cache/current-raw && bun run tools/diff-html.ts"
  },
  "pre-commit": "lint",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "devDependencies": {
    "@fec/remark-a11y-emoji": "4.0.2",
